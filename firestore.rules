rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if a user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to get user's role
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // Admins can do anything
    function isAdmin() {
      return isSignedIn() && getUserRole() == 'admin';
    }
    
    // Cashiers can read most things and create some things
    function isCashier() {
        return isSignedIn() && getUserRole() == 'cashier';
    }

    // Allow logged-in users to read and write their own user document
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    // Products: Admins can do anything, Cashiers can only read
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // Sales: Admins can do anything, Cashiers can create and read
    match /sales/{saleId} {
       allow read, create: if isSignedIn();
       allow update, delete: if isAdmin();
    }
    
    // Expenses: Admins can do anything, Cashiers can create and read
    match /expenses/{expenseId} {
       allow read, create: if isSignedIn();
       allow update, delete: if isAdmin();
    }

    // Scheduled Discounts: Admins can do anything, Cashiers can read
    match /scheduled_discounts/{discountId} {
       allow read: if isSignedIn();
       allow write: if isAdmin();
    }
    
    // Expense Categories: Admins can do anything, Cashiers can read
    match /expense_categories/{categoryId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }

    // Activity Logs: Admins can read, anyone can create
    match /activity_logs/{logId} {
        allow read: if isAdmin() || isCashier();
        allow create: if isSignedIn();
    }

    // Counters collection for transaction IDs
    match /counters/{counterId} {
      allow read, write: if isSignedIn(); // Allow any logged-in user to read/write counters
    }
  }
}
