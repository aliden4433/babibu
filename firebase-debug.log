[debug] [2025-07-07T02:21:11.765Z] >>> [apiv2][body] PUT http://127.0.0.1:8080/emulator/v1/projects/demo-app:securityRules {"ignore_errors":true,"rules":{"files":[{"name":"security.rules","content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n    \n    // Helper function to check if a user is authenticated\n    function isSignedIn() {\n      return request.auth != null;\n    }\n    \n    // Helper function to get user's role\n    function getUserRole() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;\n    }\n    \n    // Admins can do anything\n    function isAdmin() {\n      return isSignedIn() && getUserRole() == 'admin';\n    }\n    \n    // Cashiers can read most things and create some things\n    function isCashier() {\n        return isSignedIn() && getUserRole() == 'cashier';\n    }\n\n    // Allow logged-in users to read and write their own user document\n    match /users/{userId} {\n      allow read, write: if request.auth.uid == userId;\n    }\n\n    // Products: Admins can do anything, Cashiers can only read\n    match /products/{productId} {\n      allow read: if isSignedIn();\n      allow write: if isAdmin();\n    }\n    \n    // Sales: Admins can do anything, Cashiers can create and read\n    match /sales/{saleId} {\n       allow read, create: if isSignedIn();\n       allow update, delete: if isAdmin();\n    }\n    \n    // Expenses: Admins can do anything, Cashiers can create and read\n    match /expenses/{expenseId} {\n       allow read, create: if isSignedIn();\n       allow update, delete: if isAdmin();\n    }\n\n    // Scheduled Discounts: Admins can do anything, Cashiers can read\n    match /scheduled_discounts/{discountId} {\n       allow read: if isSignedIn();\n       allow write: if isAdmin();\n    }\n    \n    // Expense Categories: Admins can do anything, Cashiers can read\n    match /expense_categories/{categoryId} {\n        allow read: if isSignedIn();\n        allow write: if isAdmin();\n    }\n\n    // Activity Logs: Admins can read, anyone can create\n    match /activity_logs/{logId} {\n        allow read: if isAdmin() || isCashier();\n        allow create: if isSignedIn();\n    }\n\n    // Counters collection for transaction IDs\n    match /counters/{counterId} {\n      allow read, write: if isSignedIn(); // Allow any logged-in user to read/write counters\n    }\n  }\n}\n"}]}}
